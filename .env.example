# CCM Tool Configuration
# ------------------------------------------------------------------
# Copy this file to ".env" (same folder) and fill in your real values.
# Never commit or share the actual ".env" file - it holds live credentials.
# ------------------------------------------------------------------

# --- Action1 ---
# Get these from: Action1 console > Configuration > Users & API Credentials > + New API Credentials
ACTION1_CLIENT_ID=your_client_id_here
ACTION1_CLIENT_SECRET=your_client_secret_here

# --- Cloudflare Zero Trust ---
# Get the API token from: dash.cloudflare.com > My Profile > API Tokens > Create Token
#   (needs at least "Zero Trust: Read" permission)
# Get your Account ID from: the Zero Trust dashboard URL, or the right sidebar of the main dashboard
CLOUDFLARE_API_TOKEN=your_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# --- Nessus ---
# Get these from: Nessus web UI > Settings (top right) > My Account > API Keys > Generate
# NESSUS_HOST is wherever Nessus is running - you installed it on the Windows Server,
# reachable from your host machine through the port forward you set up (127.0.0.1:8834)
NESSUS_HOST=https://127.0.0.1:8834
NESSUS_ACCESS_KEY=your_access_key_here
NESSUS_SECRET_KEY=your_secret_key_here
