# Copy this file to a new file named ".env" (same folder) and fill in real values.
# NEVER share the real .env file, paste it into chat, or upload it anywhere.

# --- Action1 ---
# Console: Settings > API Credentials. The secret is shown only once.
ACTION1_CLIENT_ID=your_action1_client_id
ACTION1_CLIENT_SECRET=your_action1_client_secret
# The web address of YOUR region plus /api/3.0 (see action1_client.py for the list).
# Optional: if you leave this line out, the na-2 address is used.
ACTION1_BASE_URL=https://app.na-2.action1.com/api/3.0

# --- Cloudflare ---
# API token: My Profile > API Tokens. Account ID: shown on the account overview page.
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# --- Nessus ---
# Address of the Nessus web interface, as reachable from the machine running this tool.
# Include https:// and the port, with no trailing slash.
# Example (port-forwarded to the host): https://127.0.0.1:8834
NESSUS_HOST=https://127.0.0.1:8834
# Nessus: Settings > My Account > API Keys > Generate.
NESSUS_ACCESS_KEY=your_nessus_access_key
NESSUS_SECRET_KEY=your_nessus_secret_key
